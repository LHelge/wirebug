// Battery interlock harness.
//
// The stretch of the HV interlock loop (systems/safety.wb) that threads
// the battery side: out of the MSD into the front pack, through the
// tunnel loom to the rear pack (looms/tunnel.wb), and on into the HV
// junction box. This fragment adds no instances or wires of its own — it
// binds the view to the merged Vehicle namespace.

extend Vehicle {
}

// --- View: battery interlock harness ---
// The front and rear packs face each other across the tunnel loom. The MSD
// sits above the rear pack and the junction box below the front pack, so
// each interlock link crosses the page to the pack it joins.

view harness "Battery interlock harness" {
    grid: 20;

    include msd.intlk         at (40, 0);
    include front.bms_signals at (0, 12);
    include rear.bms_signals  at (40, 12);
    include hvjb.intlk        at (0, 24);
}
