// Front cooling loom.
//
// The run from the VCM to the coolant pump and the radiator fan at the
// front of the car. It carries the pump's PWM command and tacho return and
// the chassis ground that the pump and fan share with the VCM
// (systems/lv.wb); the 12 V feeds come straight from the fuse box. Like
// the engine-bay harness, this fragment adds no instances or wires of its
// own — it binds the view to the merged Vehicle namespace.

extend Vehicle {
}

// --- View: cooling loom ---
// The VCM's 12V and cooling connectors on the left, the pump and the fan
// on the right; the ground runs on from the pump to the fan.

view harness "Cooling loom" {
    grid: 20;

    include vcm.lv      at (0, 0);
    include vcm.cooling at (0, 8);
    include pump.x1     at (40, 4);
    include fan.x1      at (40, 16);
}
