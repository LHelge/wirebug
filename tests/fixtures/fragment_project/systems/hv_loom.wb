// The HV loom: the cable between the battery (declared in main.wb) and the
// inverter (declared in traction.wb), and its harness view.
extend Vehicle {
    cable hv_bus "HV bus" {
        length: 1.2;
        wire orange 50 "HV+" [pack.hv_pos, inv.dc_pos];
        wire orange 50 "HV-" [pack.hv_neg, inv.dc_neg];
    }
}

view harness "HV loom" {
    grid: 20;

    include pack.hv at (4, 8);
    include inv.hv  at (28, 8);
}
