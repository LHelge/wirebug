// The only view passes `check` but `render` cannot draw it, so a render
// has nothing to write.
//
// The failure is the `grid:` — finer than a port label needs, which only
// the renderer rejects today. When `check` learns to reject it, swap in
// another failure `check` does not catch (or drop this fixture: the unit
// tests in `render/mod.rs` cover the same decision without the CLI).
component Vehicle {
    left:  Module "Left";
    right: Module "Right";

    wire red 1 [left.sig, right.sig];

    component Module {
        pub port sig "SIG";
    }
}

view schematic "Fine Grid" {
    grid: 5;

    include left at (0, 0) ports {
        east: sig;
    }

    include right at (64, 0) ports {
        west: sig;
    }
}
