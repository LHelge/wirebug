// Every reference here resolves; only the values are nonsense. `check`
// must reject the negative and zero gauges, the negative cable and
// conductor lengths (one written in millimetres), and a length in inches.

use Device from "components/device.wb";

component Vehicle {
    ecu: Device "ECU";
    pump: Device "Pump";

    wire black -1 [ecu.gnd, pump.gnd];

    cable w1 "Supply" {
        length: -2;
        wire red 0 [ecu.pwr, pump.pwr] {
            length: -500mm;
        }
    }

    wire black 1 [ecu.gnd, pump.gnd] {
        length: 12in;
    }
}

view harness "Loom" {
    include ecu.j1 at (0, 0);
    include pump.j1 at (4, 0);
}
