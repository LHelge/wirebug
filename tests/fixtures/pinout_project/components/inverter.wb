// Pins declared out of order (42 after 45; 46, 48, 47, 49), a label too
// long for its cavity, cavities no port uses (40, 41, 43, 44 on the face;
// 5, 6 on the grid), a port with no pin (SPARE), and ports no conductor
// reaches (TEMP+, IGNITION SWITCHED FEED).

use Control from "connectors.wb";
use Signal from "connectors.wb";

component Inverter {
    connector control: Control {
        pub port temp_pos "TEMP+" pin 45;
        pub port ignition "IGNITION SWITCHED FEED" pin 42;
        pub port b_pos "B+" pins [46, 48];
        pub port b_neg "B-" pins [47, 49];
    }

    connector signal: Signal {
        pub port can_h "CAN H" pin 3;
        pub port can_l "CAN L" pin 1;
        pub port wake  "WAKE"  pin 4;
        pub port shld  "SHLD"  pin 2;
        pub port spare "SPARE";
    }
}

view pinout "Inverter pinouts" {
    grid: 20;

    include control at (0, 0);
    include signal at (0, 18);
}
