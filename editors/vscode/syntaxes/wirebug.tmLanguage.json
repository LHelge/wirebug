{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wirebug",
  "scopeName": "source.wirebug",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#type-declaration" },
    { "include": "#use-import" },
    { "include": "#fragment-import" },
    { "include": "#shield-statement" },
    { "include": "#splice-statement" },
    { "include": "#view-kind" },
    { "include": "#view-subject" },
    { "include": "#numbering-mode" },
    { "include": "#wire-color" },
    { "include": "#declared-name" },
    { "include": "#include-target" },
    { "include": "#instance-name" },
    { "include": "#property-key" },
    { "include": "#member-access" },
    { "include": "#enclosure-port" },
    { "include": "#ports-block" },
    { "include": "#at-coordinates" },
    { "include": "#keywords" },
    { "include": "#type-name" },
    { "include": "#numbers" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.wirebug"
    },
    "strings": {
      "match": "\"[^\"]*\"",
      "name": "string.quoted.double.wirebug"
    },
    "type-declaration": {
      "match": "\\b(component|extend|connector_type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "storage.type.wirebug" },
        "2": { "name": "entity.name.type.declaration.wirebug" }
      }
    },
    "use-import": {
      "match": "\\b(use)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.control.import.wirebug" },
        "2": { "name": "entity.name.type.wirebug" }
      }
    },
    "fragment-import": {
      "comment": "`fragment \"<path>\";` starts a top-level statement. Only there: anywhere else `fragment` is an ordinary name (`pub port fragment \"F\";`, `fragment: Lamp;`).",
      "match": "^\\s*(fragment)(?=\\s*\")",
      "captures": {
        "1": { "name": "keyword.control.import.wirebug" }
      }
    },
    "shield-statement": {
      "comment": "`shield [\"<label>\"] [<ends>];` starts a statement in a cable body or a `twisted { }` group. Only there: anywhere else `shield` is an ordinary name (`pub port shield \"S\";`, `shield: Lamp;`, `[ecu.shield, b]`).",
      "match": "(?:^|(?<=[{;]))\\s*(shield)(?=\\s*(?:\"|\\[|;))",
      "captures": {
        "1": { "name": "storage.type.wirebug" }
      }
    },
    "splice-statement": {
      "comment": "`splice <name> [\"<label>\"];` starts a statement in a component body, a name following it. Only there: anywhere else `splice` is an ordinary name (`pub port splice \"S\";`, `splice: Sensor;`, `[ecu.splice, b]`).",
      "match": "(?:^|(?<=[{;]))\\s*(splice)\\s+([a-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "storage.type.wirebug" },
        "2": { "name": "variable.other.declaration.wirebug" }
      }
    },
    "view-kind": {
      "match": "\\b(view)\\s+(schematic|harness|pinout)\\b",
      "captures": {
        "1": { "name": "storage.type.wirebug" },
        "2": { "name": "support.constant.view-kind.wirebug" }
      }
    },
    "view-subject": {
      "comment": "`for Component` right after a view's title names its subject. Only there: anywhere else `for` is an ordinary name (`pub port for \"F\";`).",
      "match": "(?<=\")\\s*\\b(for)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.wirebug" },
        "2": { "name": "entity.name.type.wirebug" }
      }
    },
    "numbering-mode": {
      "match": "\\b(numbering)\\s*(:)\\s*(row_major|odd_even|clockwise|counter_clockwise)\\b",
      "captures": {
        "1": { "name": "keyword.other.wirebug" },
        "2": { "name": "punctuation.separator.key-value.wirebug" },
        "3": { "name": "support.constant.numbering.wirebug" }
      }
    },
    "wire-color": {
      "match": "\\b(wire)\\s+([a-z_][a-z0-9_]*)(?:\\s*(/)\\s*([a-z_][a-z0-9_]*))?\\b",
      "captures": {
        "1": { "name": "storage.type.wirebug" },
        "2": { "name": "support.constant.color.wirebug" },
        "3": { "name": "punctuation.separator.color.wirebug" },
        "4": { "name": "support.constant.color.wirebug" }
      }
    },
    "declared-name": {
      "comment": "The name after a declaring keyword. Contextual keywords (size, grid, at, …) are ordinary names here, so this runs before #keywords. `text` takes a name only in its deprecated named form (`text note at (…) \"…\"`); the current `text \"…\" at (…)` does not match here, so #keywords takes `text` and #strings its label.",
      "match": "\\b(port|connector|inline|cable|text)\\s+([a-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "storage.type.wirebug" },
        "2": { "name": "variable.other.declaration.wirebug" }
      }
    },
    "include-target": {
      "comment": "Not `include at (…)`: that is an enclosure port named `include` (see #enclosure-port).",
      "match": "\\b(include)\\s+(?!at\\s*\\()([a-z_][A-Za-z0-9_]*)(?:\\s*(\\.)\\s*([a-z_][A-Za-z0-9_]*))?",
      "captures": {
        "1": { "name": "keyword.other.wirebug" },
        "2": { "name": "variable.other.wirebug" },
        "3": { "name": "punctuation.accessor.wirebug" },
        "4": { "name": "variable.other.member.wirebug" }
      }
    },
    "instance-name": {
      "comment": "`name: Type` — an instance (types are CamelCase), whatever word names it. Not an inline's `male:`/`female:` housing line.",
      "match": "\\b(?!(?:male|female)\\s*:)([a-z_][A-Za-z0-9_]*)\\s*(:)\\s*(?=[A-Z])",
      "captures": {
        "1": { "name": "variable.other.declaration.wirebug" },
        "2": { "name": "punctuation.separator.key-value.wirebug" }
      }
    },
    "property-key": {
      "comment": "`key: value;` in a cable body, a wire body, a splice body, a connector_type, or a component body (part data): `length`, `type`, `part`, `manufacturer`, `description` and `rating` are property keys, not keywords. After #instance-name, so `part: Plug;` stays an instance, as in the parser: a type name after the colon is an instance, a string or number a property.",
      "match": "\\b(length|type|part|manufacturer|description|rating)\\s*(:)",
      "captures": {
        "1": { "name": "support.type.property-name.wirebug" },
        "2": { "name": "punctuation.separator.key-value.wirebug" }
      }
    },
    "member-access": {
      "comment": "`instance.port` in a wire endpoint list.",
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(\\.)\\s*([a-z_][A-Za-z0-9_]*)\\b",
      "captures": {
        "1": { "name": "variable.other.wirebug" },
        "2": { "name": "punctuation.accessor.wirebug" },
        "3": { "name": "variable.other.member.wirebug" }
      }
    },
    "enclosure-port": {
      "comment": "`port at (x, y);` in an enclosure: the port before `at` is a name.",
      "match": "\\b([a-z_][A-Za-z0-9_]*)\\s+(?=at\\s*\\()",
      "captures": {
        "1": { "name": "variable.other.wirebug" }
      }
    },
    "ports-block": {
      "begin": "\\b(ports)\\s*(\\{)",
      "end": "\\}",
      "beginCaptures": {
        "1": { "name": "keyword.other.wirebug" },
        "2": { "name": "punctuation.section.block.begin.wirebug" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.block.end.wirebug" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "match": "\\b(north|east|south|west)\\b(?=\\s*:)",
          "name": "constant.language.side.wirebug"
        },
        { "include": "#punctuation" }
      ]
    },
    "at-coordinates": {
      "begin": "\\b(at)\\s*(\\()",
      "end": "\\)",
      "beginCaptures": {
        "1": { "name": "keyword.other.wirebug" },
        "2": { "name": "punctuation.section.parens.begin.wirebug" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.section.parens.end.wirebug" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "match": "\\b(north|east|south|west)\\b",
          "name": "constant.language.side.wirebug"
        },
        { "include": "#numbers" },
        { "include": "#punctuation" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(use|from)\\b",
          "name": "keyword.control.import.wirebug"
        },
        {
          "match": "\\b(component|extend|connector_type|connector|inline|port|wire|cable|twisted|view|enclosure|text)\\b",
          "name": "storage.type.wirebug"
        },
        {
          "match": "\\bpub\\b",
          "name": "storage.modifier.wirebug"
        },
        {
          "match": "\\b(include|at|grid|pin|pins|face|cavity|layout|rows|cols|numbering|size|ports)\\b",
          "name": "keyword.other.wirebug"
        }
      ]
    },
    "type-name": {
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b",
      "name": "entity.name.type.wirebug"
    },
    "numbers": {
      "comment": "A number, and a length unit written directly after it (`150mm`). Any other suffix is no unit: the number is left unscoped, as the check reports it.",
      "match": "(?<!\\w)-?\\d+(?:\\.\\d+)?(?:(m|cm|mm)\\b|\\b)",
      "name": "constant.numeric.wirebug",
      "captures": {
        "1": { "name": "keyword.other.unit.wirebug" }
      }
    },
    "punctuation": {
      "patterns": [
        { "match": ";", "name": "punctuation.terminator.statement.wirebug" },
        { "match": ",", "name": "punctuation.separator.comma.wirebug" },
        { "match": "\\.", "name": "punctuation.accessor.wirebug" },
        { "match": ":", "name": "punctuation.separator.key-value.wirebug" },
        { "match": "\\{", "name": "punctuation.section.block.begin.wirebug" },
        { "match": "\\}", "name": "punctuation.section.block.end.wirebug" },
        { "match": "\\[", "name": "punctuation.section.brackets.begin.wirebug" },
        { "match": "\\]", "name": "punctuation.section.brackets.end.wirebug" },
        { "match": "\\(", "name": "punctuation.section.parens.begin.wirebug" },
        { "match": "\\)", "name": "punctuation.section.parens.end.wirebug" }
      ]
    }
  }
}
